# Marieta — Environment Configuration
# Copy this file to .env and fill in values before running docker compose up.

# Database
POSTGRES_USER=marieta
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=marieta
DATABASE_URL=postgresql+asyncpg://marieta:change-me-in-production@postgres:5432/marieta
DATABASE_URL_SYNC=postgresql://marieta:change-me-in-production@postgres:5432/marieta

# Redis
REDIS_URL=redis://redis:6379/0

# Session & Security
SESSION_SECRET=replace-with-a-random-string-at-least-32-chars
CSRF_SECRET=replace-with-another-random-string-at-least-32-chars
SESSION_MAX_AGE_SECONDS=604800

# Ollama (LLM)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=gemma4:latest

# USDA API (optional)
# USDA_FDC_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:8080

# App
APP_VERSION=0.1.0
LOG_LEVEL=INFO
